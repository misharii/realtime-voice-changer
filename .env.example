# --- Provider -------------------------------------------------------------
# Which Voice Transformer to use. Currently: fish
PROVIDER=fish

FISH_API_KEY=
FISH_BASE_URL=https://api.fish.audio
FISH_TTS_MODEL=s2.1-pro-free
# normal | balanced  (balanced = lower latency)
FISH_TTS_LATENCY=balanced
FISH_TTS_SAMPLE_RATE=44100
# --- Speech-to-text -------------------------------------------------------
# openrouter | fish   (fish ASR needs paid Fish API credit)
STT_PROVIDER=openrouter
OPENROUTER_API_KEY=
# qwen/qwen3-asr-0.6b: fastest + cheapest that handled Arabic in testing.
# Alternatives: openai/whisper-large-v3-turbo, deepgram/nova-3 (English only w/o language)
OPENROUTER_STT_MODEL=qwen/qwen3-asr-0.6b
# Leave empty to auto-detect (Arabic/English), or e.g. en / ar
OPENROUTER_STT_LANGUAGE=
FISH_ASR_LANGUAGE=

# Placeholder for later
# ELEVENLABS_API_KEY=

# --- Target Voices --------------------------------------------------------
# name:reference_id pairs, comma separated. Ctrl+Alt+1..9 picks by position.
# Find ids on https://fish.audio (the id in a voice's URL).
VOICES=myvoice:e3dda6dcef7a4ff681413b88e75db807

# --- Devices --------------------------------------------------------------
# Substring of the device name (case-insensitive). Empty = system default.
INPUT_DEVICE=Microphone Array
OUTPUT_DEVICE=CABLE Input
MONITORING=false
# Empty = system default output
MONITOR_DEVICE=

# --- Phrase detection (Silero VAD) ----------------------------------------
VAD_THRESHOLD=0.5
VAD_SILENCE_MS=400
VAD_MIN_PHRASE_MS=250
# Audio kept from just before speech starts, so first syllables aren't clipped
VAD_PREROLL_MS=200
# Force-cut very long Phrases
VAD_MAX_PHRASE_MS=15000

# --- Reliability ----------------------------------------------------------
# Seconds before a Phrase is dropped (per ASR call / until first TTS audio)
TRANSFORM_TIMEOUT_S=3
